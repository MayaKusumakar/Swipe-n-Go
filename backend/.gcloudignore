# Files NOT uploaded by `gcloud app deploy`.
.gcloudignore
.git/
.gitignore

# Virtual environments
.venv/
venv/
env/

# Python cache and test artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
tests/
requirements-dev.txt

# Dev-only scripts (seeding)
scripts/

# Local env files and secrets
.env
.env.*
*.pem
*-key.json
credentials*.json

# Editors and OS files
.idea/
.vscode/
*.log
.DS_Store
