# Copy the lines you need into your shell (export ...) or a local .env.
# Placeholder names only. Never commit real values.

# GCP project that has Firestore in Datastore Mode enabled.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Datastore namespace to read/write. The seed script writes to "dev".
DATASTORE_NAMESPACE=dev

# Local dev only: "memory" serves built-in sample events without Datastore.
# Leave unset to use Datastore. Never set this on App Engine.
# EVENT_STORE=memory

# Set only when using the local Datastore emulator.
# DATASTORE_EMULATOR_HOST=localhost:8081

# Claude API key for the AI planner (POST /api/planner). Locally, copy this file
# to backend/.env and paste the real key there; `flask run` loads .env, and .env
# is never committed. In production, use Secret Manager.
# Without a key the planner answers 503 ai_unavailable and the app plans on-device.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Event summaries (/tasks/summarize-stale). Off = free template summaries.
# "on" uses Claude for summaries, which costs money per summary, and only
# takes effect when ANTHROPIC_API_KEY is also set. Leave unset to stay at $0.
# AI_SUMMARIES=on

# Sign-in: only verified @ucdavis.edu Google accounts. Comma-separated OAuth
# client IDs whose tokens this server accepts (the iOS client ID from Google
# Cloud Console → APIs & Services → Credentials). Free; no billing needed.
GOOGLE_CLIENT_IDS=your-ios-client-id.apps.googleusercontent.com

# Local testing before the client IDs exist: accepts "dev:<email>:<name>"
# tokens (email must still be @ucdavis.edu). Ignored on App Engine. Never
# turn on for a server other people can reach.
# DEV_SIGN_IN=on
