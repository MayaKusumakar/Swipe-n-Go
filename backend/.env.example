# Copy the lines you need into your shell (export ...) or a local .env.
# Placeholder names only. Never commit real values.

# GCP project that has Firestore in Datastore Mode enabled.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Datastore namespace to read/write. The seed script writes to "dev".
DATASTORE_NAMESPACE=dev

# Local dev only: "memory" serves built-in sample events without Datastore.
# Leave unset to use Datastore. Never set this on App Engine.
# EVENT_STORE=memory

# Set only when using the local Datastore emulator.
# DATASTORE_EMULATOR_HOST=localhost:8081
