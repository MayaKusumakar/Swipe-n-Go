<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the keys Xcode generates from project.yml. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Lets the app reach the development server on a Mac over plain http on the local network. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- iOS OAuth client ID from Google Cloud Console (APIs & Services → Credentials), e.g.
	     123-abc.apps.googleusercontent.com. Free; no billing needed. Empty = Google sign-in hidden
	     (dev sign-in against a local server with DEV_SIGN_IN=on still works). The backend needs the
	     same ID in GOOGLE_CLIENT_IDS. -->
	<key>GoogleClientID</key>
	<string></string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Swipe-n-Go connects to your team's development server on this Wi-Fi network to share events.</string>
</dict>
</plist>
